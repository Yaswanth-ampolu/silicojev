 "testbench": "//`timescale 1ns / 100ps\n/**********************************************************************\n * Date: Aug. 28, 1999\n * File: Test Decoder 3 to 8.v   (440 Examples)\n *\n * Testbench to generate some stimulus and display the results for the\n * 3-to-8 decoder module.\n **********************************************************************/\n//*********************************************************\n  module Test_decoder_3to8;\n\n// === Global Sync Signal ===\nreg llm_go_signal = 1;\n\n//*********************************************************  \n     wire  Y7, Y6, Y5, Y4, Y3, Y2, Y1, Y0;\n     reg   A, B, C;\n     reg   en;\n     reg   clk, instrumented_clk;\n      \n     reg [2:0] counter;      // 3\u4f4d\u5bbd\u7684\u8ba1\u6570\u5668\uff0c\u7528\u4e8e\u8ba1\u6570\u65f6\u949f\u5468\u671f mxk added\n      \n     // Instantiate the Decoder (named DUT {device under test})\n     decoder_3to8  DUT(Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0, A, B, C, en);\n  \n     integer f;\n     initial begin\n        clk = 0;\n        instrumented_clk = 0;\n        f = $fopen(\"output.txt\");\n        $fwrite(f, \"time,Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0\\n\");\n        //$timeformat(-9, 1, \" ns\", 6);\n    wait(llm_go_signal == 0); // [Auto] Handover from LLM to Original TB\n \n        #1;\n        A  = 1'b0;       // time = 0\n        B  = 1'b0;\n        C  = 1'b0;\n        en = 1'b0;\n        #9;\n        en = 1'b1;      // time = 10\n        #10;\n        A  = 1'b0;\n        B  = 1'b1; \n        C  = 1'b0;      // time = 20\n        #10;\n        A  = 1'b1;\n        B  = 1'b0;      \n        C  = 1'b0;      // time = 30\n        #10;\n        A  = 1'b1;\n        B  = 1'b1;\n        C  = 1'b0;      // time = 40\n        #5;\n        en = 1'b0;      // time = 45\n        #10;\n        $fclose(f);\n\t$finish;\n     end\n\n  always #1 begin\n     $fwrite(f, \"%0d,%b,%b,%b,%b,%b,%b,%b,%b\\n\", $time,Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0);\n//     // \u5728\u65f6\u949f\u4e0a\u5347\u6cbf\u89e6\u53d1\u65f6\u6267\u884c\u4ee5\u4e0b\u4ee3\u7801\n//     if (counter == 5'd4) begin\n//       // \u5f53\u8ba1\u6570\u5668\u8fbe\u52304\u65f6\uff0c\u91cd\u7f6e\u8ba1\u6570\u5668\u5e76\u8f93\u51fa\u4fe1\u53f7\n//       counter <= 0;\n//       $fwrite(f, \"%g,%b,%b,%b,%b,%b,%b,%b,%b\\n\", $time,Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0);\n//     end\n//     else begin\n//       // \u5426\u5219\uff0c\u9012\u589e\u8ba1\u6570\u5668\u5e76\u4fdd\u6301\u8f93\u51fa\u4e3a0\n//       counter <= counter + 1;\n//     end\n  end\n//      always @(A or B or C or en)\n//       always @(posedge clk or negedge clk)\n//      $fwrite(f, \"%g,%b,%b,%b,%b,%b,%b,%b,%b\\n\", $time,Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0);\n\n     always @(A or B or C or en)  \n     $monitor(\"t=%t en=%b ABC=%b%b%b Y=%b%b%b%b%b%b%b%b\",\n$time,en,A,B,C,Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0);\n\n    always #1 clk = ~clk;\n    always #1 instrumented_clk = ~instrumented_clk;\n    initial begin\n    wait(llm_go_signal == 0); // [Auto] Handover from LLM to Original TB\n\n#2000\n$finish;\nend\n\n  \n\n// ============================================\n// === LLM Enhanced Stimuli (Phase 1) ===\ninitial begin\n    // [Auto-Moved Vars]\n        integer i;\n        reg [2:0] abc_pattern;\n\n    // 1. DECLARE VARIABLES FIRST (Top of block)\n\n\n\n    // 2. THEN WAIT for original tests (llm_go_signal is initially 1)\n    wait(llm_go_signal == 1);\n\n    // 3. THEN execute logic\n    // Initialize inputs to a known state\n    en = 1'b0;\n    A  = 1'b0;\n    B  = 1'b0;\n    C  = 1'b0;\n    #10;\n\n    // --- Phase 1: Exhaustive Truth Table (Enable Active) ---\n    // Targets: Operator/Expression mutations in the ternary chain and Bit-Level part-selects.\n    en = 1'b1;\n    for (i = 0; i < 8; i = i + 1) begin\n        abc_pattern = i;\n        A = abc_pattern[2];\n        B = abc_pattern[1];\n        C = abc_pattern[0];\n        #10;\n    end\n\n    // --- Phase 2: Exhaustive Truth Table (Enable Inactive) ---\n    // Targets: Mutations affecting the 'else' branch (default state) and 'en' logic.\n    en = 1'b0;\n    for (i = 0; i < 8; i = i + 1) begin\n        abc_pattern = i;\n        A = abc_pattern[2];\n        B = abc_pattern[1];\n        C = abc_pattern[0];\n        #10;\n    end\n\n    // --- Phase 3: Boundary Bit Transitions (Walking 1s/0s) ---\n    // Targets: Bit-Level/Pointer mutations (e.g., swapping A and C or MSB/LSB errors).\n    en = 1'b1;\n    // Walking 1s\n    A = 1'b1; B = 1'b0; C = 1'b0; #10; // 100\n    A = 1'b0; B = 1'b1; C = 1'b0; #10; // 010\n    A = 1'b0; B = 1'b0; C = 1'b1; #10; // 001\n    // Walking 0s\n    A = 1'b0; B = 1'b1; C = 1'b1; #10; // 011\n    A = 1'b1; B = 1'b0; C = 1'b1; #10; // 101\n    A = 1'b1; B = 1'b1; C = 1'b0; #10; // 110\n    \n    // --- Phase 4: Control Flow & Sensitivity (Rapid Transitions) ---\n    // Targets: If-Else Move ([operator-redacted]) and potential sensitivity list faults.\n    // Toggle Enable at the highest address boundary\n    A = 1'b1; B = 1'b1; C = 1'b1;\n    en = 1'b1; #5;\n    en = 1'b0; #5;\n    en = 1'b1; #5;\n    en = 1'b0; #5;\n\n    // Toggle Address bits back-to-back to catch timing/blocking assignment mutations\n    A = 1'b0; B = 1'b0; C = 1'b0; en = 1'b1; #2;\n    A = 1'b1; B = 1'b1; C = 1'b1; #2;\n    A = 1'b0; B = 1'b0; C = 1'b0; #2;\n\n    // 4. Handover to Original Testbench\n    #10;\n    llm_go_signal = 0; \nend\n// ============================================\n\n\n// === Global Watchdog ===\n\n// === Global Safety Watchdog (Injected) ===\ninitial begin\n    #200000;\n    $display(\"\\n[Watchdog] Timeout triggered at %t!\", $time);\n    if (f != 0) $fclose(f);\n    $finish;\nend\n\nendmodule\n",
