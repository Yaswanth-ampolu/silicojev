# Local model/checkpoint artifacts (multi-gigabyte; keep outside GitHub).
checkpoints/

# Python and notebook caches.
**/__pycache__/
*.py[cod]
.ipynb_checkpoints/

# GitHub rejects this raw archive because it is over 1 GB.
dataset/raw/hf/CircuitNet3/circuitNetv3.zip

# Graphify's generated extraction cache is reproducible and not source code.
graphify-out/cache/
graphify-out/.graphify_*

# Do not vendor nested repository metadata.
**/.git/

# Raw external datasets are reproducible downloads (URLs + sha256 are recorded in
# dataset/EXTERNAL_DATASETS.md); the converted records are what the repo tracks.
dataset/raw/

# Replay/distillation scratch and caches are reproducible build artifacts.
training/fixbench_replay_cache/
training/fixbench_distill_scratch/

# VeriBugBench: the rendered corpora are large (175-180 MB each) and rebuild
# from dataset/raw/ + the committed training/ scripts. Only the 5q labels are
# tracked (via Git LFS); the 3q skeleton, 3q build and measured view are not.
dataset/converted/veribugbench/skeleton_3q.jsonl
dataset/converted/veribugbench/veribugbench_3q.jsonl
dataset/converted/veribugbench/veribugbench_3q_measured.jsonl
dataset/converted/veribugbench/veribugbench_5q.REJECTED_near_constant.jsonl
